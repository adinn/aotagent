<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>aotagent-agent</artifactId>
    <parent>
        <groupId>org.my.aotagent</groupId>
        <artifactId>aotagent-root</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Premain-Class>org.my.aotagent.main.AOTAgentMain</Premain-Class>
                            <Agent-Class>org.my.aotagent.main.AOTAgentMain</Agent-Class>
                            <Can-Redefine-Classes>true</Can-Redefine-Classes>
                            <Can-Retransform-Classes>true</Can-Retransform-Classes>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>org.ow2.asm:asm</include>
                                    <include>org.ow2.asm:asm-tree</include>
                                    <include>org.ow2.asm:asm-analysis</include>
                                    <include>org.ow2.asm:asm-commons</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>org.ow2.asm:asm</artifact>
                                    <includes>
                                        <include>org/objectweb/asm/**</include>
                                    </includes>
                                </filter>
                                <filter>
                                    <artifact>org.ow2.asm:asm-tree</artifact>
                                    <includes>
                                        <include>org/objectweb/asm/**</include>
                                    </includes>
                                </filter>
                                <filter>
                                    <artifact>org.ow2.asm:asm-analysis</artifact>
                                    <includes>
                                        <include>org/objectweb/asm/**</include>
                                    </includes>
                                </filter>
                                <filter>
                                    <artifact>org.ow2.asm:asm-commons</artifact>
                                    <includes>
                                        <include>org/objectweb/asm/**</include>
                                    </includes>
                                </filter>
                            </filters>
                            <relocations>
                                <relocation>
                                    <pattern>org.ow2.asm</pattern>
                                    <shadedPattern>org.my.aotagent.shaded.org.objectweb.asm</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.my.aotagent</groupId>
            <artifactId>aotagent-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <scope>compile</scope>
            <version>9.10.1</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
            <scope>compile</scope>
            <version>9.10.1</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-analysis</artifactId>
            <scope>compile</scope>
            <version>9.10.1</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
            <scope>compile</scope>
            <version>9.10.1</version>
        </dependency>
    </dependencies>
    <profiles>
      <profile>
            <!-- profile which includes asm unshaded to allow debugging -->
            <id>asmdebug</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <artifactSet>
                                        <includes>
                                            <include>org.ow2.asm:asm</include>
                                            <include>org.ow2.asm:asm-tree</include>
                                            <include>org.ow2.asm:asm-analysis</include>
                                            <include>org.ow2.asm:asm-commons</include>
                                        </includes>
                                    </artifactSet>
                                    <filters>
                                        <filter>
                                            <artifact>org.ow2.asm:asm</artifact>
                                            <includes>
                                                <include>org/objectweb/asm/**</include>
                                            </includes>
                                        </filter>
                                        <filter>
                                            <artifact>org.ow2.asm:asm-tree</artifact>
                                            <includes>
                                                <include>org/objectweb/asm/**</include>
                                            </includes>
                                        </filter>
                                        <filter>
                                            <artifact>org.ow2.asm:asm-analysis</artifact>
                                            <includes>
                                                <include>org/objectweb/asm/**</include>
                                            </includes>
                                        </filter>
                                        <filter>
                                            <artifact>org.ow2.asm:asm-commons</artifact>
                                            <includes>
                                                <include>org/objectweb/asm/**</include>
                                            </includes>
                                        </filter>
                                    </filters>
                                    <relocations>
                                        <relocation>
                                            <pattern>org.objectweb.asm</pattern>
                                            <shadedPattern>org.objectweb.asm</shadedPattern>
                                        </relocation>
                                    </relocations>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
